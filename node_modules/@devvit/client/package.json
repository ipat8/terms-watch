{
  "name": "@devvit/client",
  "version": "0.15.4",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://developers.reddit.com/"
  },
  "type": "module",
  "exports": {
    ".": {
      "browser": "./index.js",
      "default": "./clientImportInServerCodePanic.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "**"
  ],
  "scripts": {
    "build": "tsc",
    "build:min": "esbuild --bundle --format=esm --minify --sourcemap=linked --target=es2020",
    "clean": "rm -rf .turbo coverage dist",
    "clobber": "yarn clean && rm -rf node_modules",
    "lint": "redlint .",
    "lint:fix": "yarn lint --fix",
    "prepublishOnly": "publish-package-json",
    "test": "yarn test:unit && yarn test:types && yarn lint && yarn test:size",
    "test:size": "yarn build:min src/index.ts --metafile=dist/client-meta.min.json --outfile=dist/client.min.js && filesize",
    "test:types": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit-with-coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@devvit/protos": "0.15.4",
    "@devvit/shared": "0.15.4",
    "@devvit/shared-types": "0.15.4",
    "@devvit/web-view-scripts": "0.15.4"
  },
  "devDependencies": {
    "@ampproject/filesize": "4.3.0",
    "@devvit/repo-tools": "0.15.4",
    "@devvit/tsconfig": "0.15.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "esbuild": "0.25.9",
    "eslint": "9.11.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.0"
  },
  "filesize": {
    "dist/client.min.js": {
      "gzip": "5 KB",
      "none": "15 KB"
    }
  },
  "gitHead": "5561afa7939635e1fe86eb2abccf382fb40db1ef"
}
